#!/usr/bin/env bash

#############################################
# General config
#############################################

yabai -m config                                 \
    mouse_follows_focus          off            \
    focus_follows_mouse          off            \
    window_origin_display        default        \
    window_placement             second_child   \
    window_zoom_persist          on             \
    window_topmost               off            \
    window_shadow                on             \
    window_opacity_duration      0.0            \
    active_window_opacity        1.0            \
    normal_window_opacity        0.90           \
    window_opacity               off            \
    insert_feedback_color        0xff00BFFF     \
    active_window_border_color   0xff22db18     \
    normal_window_border_color   0xff444444     \
    window_border_width          4              \
    window_border_radius         10             \
    window_border_blur           off            \
    window_border_hidpi          on             \
    window_border                on             \
    split_ratio                  0.50           \
    split_type                   auto           \
    auto_balance                 off            \
    top_padding                  32             \
    bottom_padding               32             \
    left_padding                 32             \
    right_padding                32             \
    window_gap                   12             \
    layout                       bsp            \
    mouse_modifier               fn             \
    mouse_action1                move           \
    mouse_action2                resize         \
    mouse_drop_action            swap


#############################################
# Rules
#############################################

# VSCode managed
yabai -m rule --add app="Code" manage=on

# Example floating apps
yabai -m rule --add app="System Settings" manage=off
yabai -m rule --add app="Calculator" manage=off
yabai -m rule --add app="Finder" title="Info" manage=off


#############################################
# Startup
#############################################

echo "$(date '+%Y-%m-%d %H:%M:%S') - yabai configuration loaded"

